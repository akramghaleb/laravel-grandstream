{
    "name": "akramghaleb/laravel-grandstream",
    "description": "Laravel SDK for Grandstream Devices",
    "keywords": [
        "Akram Ghaleb",
        "laravel",
        "laravel-grandstream",
        "grandstream"
    ],
    "homepage": "https://github.com/akramghaleb/laravel-grandstream",
    "license": "MIT",
    "authors": [
        {
            "name": "Akram Ghaleb",
            "email": "46090581+akramghaleb@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^10.0||^11.0||^12.0||^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "larastan/larastan": "^2.19||^3.0",
        "nunomaduro/collision": "^7.8||^8.0||^9.0",
        "orchestra/testbench": "^8.0||^9.0||^10.0||^11.0",
        "pestphp/pest": "^2.34||^3.0||^4.0",
        "pestphp/pest-plugin-arch": "^2.0||^3.0||^4.0",
        "pestphp/pest-plugin-laravel": "^2.0||^3.0||^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "AkramGhaleb\\LaravelGrandstream\\": "src/",
            "AkramGhaleb\\LaravelGrandstream\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AkramGhaleb\\LaravelGrandstream\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AkramGhaleb\\LaravelGrandstream\\LaravelGrandstreamServiceProvider"
            ],
            "aliases": {
                "LaravelGrandstream": "Grandstream"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
